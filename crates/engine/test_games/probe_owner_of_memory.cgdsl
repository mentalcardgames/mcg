// Probe: owner of highest <memory> key-order bug
// If bug exists, owner_of_memory builds key as <memory>_<player> instead of <player>_<memory>
player P1, P2
turnorder (P:P1, P:P2)
memory M on table

// Set per-player memory via score-to-memory action
// This creates P1_M = 10, P2_M = 20
stage ScoreSetup for current 2 times {
    score 10 to M of current
    cycle to next
}

// owner of highest M should find the player with max M value
stage Test for current 1 times {
    score 5 to (owner of highest M)
    end stage
}
