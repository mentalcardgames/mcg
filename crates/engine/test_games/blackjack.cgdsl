// Blackjack (casino-style, simplified) — 3 players vs. a table dealer.
//
// Rules:
//   - 52-card deck, Ace counts 11 (no soft-ace handling).
//   - Each player is dealt 2 cards; the dealer 1 (face up).
//   - Players take turns: hit (accept the optional) or stand (decline).
//     Busted hands (sum > 21) are eliminated automatically.
//   - The dealer then draws while their hand sums below 17.
//   - Players whose hand does not beat the dealer are eliminated; the
//     remaining players score their hand and the highest score wins.
//
// Engine notes:
//   - A player who stands is re-asked in later rounds (standing is not
//     tracked), so the Play stage is bounded to 12 turns.
//   - `cycle to next` wraps onto the current player when nobody else is
//     eligible, and a player who is out of the game is never prompted
//     (their instructions are skipped) — so no guards are needed
//     (2026-08-10, I-13 relaxed).
//   - When every player busts, the stage auto-ends with an empty winner
//     set (no player is in the game any more).

player P1, P2, P3
turnorder (P:P1, P:P2, P:P3)
location Hand on all
location DealerHand on table
location Deck on table

card on Deck:
  Rank(Ace, Two, Three, Four, Five, Six, Seven, Eight, Nine, Ten, Jack, Queen, King)
    for Suit(Diamonds, Clubs, Hearts, Spades)

points BJ on Rank(
  Ace: 11, Two: 2, Three: 3, Four: 4, Five: 5, Six: 6,
  Seven: 7, Eight: 8, Nine: 9, Ten: 10,
  Jack: 10, Queen: 10, King: 10
)

shuffle Deck

stage Deal for current 1 times {
  deal 2 from Deck private to Hand of P:P1
  deal 2 from Deck private to Hand of P:P2
  deal 2 from Deck private to Hand of P:P3
  deal 1 from Deck private to DealerHand
}

// Each player may hit (accept) or stand (decline); up to 4 full rounds.
// Busted players are skipped automatically (no `if (not current out of
// game)` guard needed) and `cycle to next` never errors (it wraps onto
// the current player when it is the only eligible one).
stage Play for current 12 times {
  optional {
    deal 1 from Deck private to Hand of current
    if (sum of Hand of current using BJ > 21) {
      set current out of game
    }
  }
  cycle to next
}

// Dealer draws while below 17 (bounded to 10 attempts).
stage Dealer for current 10 times {
  if (sum of DealerHand using BJ < 17) {
    deal 1 from Deck private to DealerHand
  }
}

// Eliminate players the dealer beats; survivors score their hand.
// Each player is handled explicitly (one pass per player — the dealer
// plays once, so no cycling is needed). Busted players stay out of game
// and are ignored by the winner rule regardless of their hand total.
stage Score for current 1 times {
  if (sum of Hand of P:P1 using BJ > sum of DealerHand using BJ) {
    score sum of Hand of P:P1 using BJ to P:P1
  }
  if (sum of Hand of P:P2 using BJ > sum of DealerHand using BJ) {
    score sum of Hand of P:P2 using BJ to P:P2
  }
  if (sum of Hand of P:P3 using BJ > sum of DealerHand using BJ) {
    score sum of Hand of P:P3 using BJ to P:P3
  }
}

stage End for current 1 times {
  winner is highest score
}
