// Tests: score with SumOfCardSet aggregate int expression to Runtime::Current
// Move Ace+King (11+10=21) to shared Hand, score to current and to explicit player
player P1, P2
turnorder (P:P1, P:P2)
location Hand on table
location Deck on table

card on Deck:
  Rank(Ace, King) for Suit(Diamonds), Rank(Ace, King) for Suit(Hearts)

points TestValues on Rank(Ace: 11, King: 10)

stage Play for current 1 times {
  deal 2 from Deck private to Hand
  score sum of Hand using TestValues to current
  score sum of Hand using TestValues to P:P2
  end stage
}
